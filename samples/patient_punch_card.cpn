<int/>
<layout>colset Experience = int;</layout>
</color>
<color id="af0be8b4-b644-4a30-859f-fef32fb65279">
<id>Gender</id>
<enum><id>male</id><id>female</id></enum>
<layout>colset Gender = with male|female;</layout>
</color>
<color id="2485f676-1504-4558-a4db-fb1595b89296">
<!-- cpn-editor:colour=#ef4444 -->
<id>Pat</id>
<product><id>PatientID</id><id>Name</id><id>Address</id><id>DateOfBirth</id><id>Gender</id></product>
<layout>colset Pat = product PatientID * Name * Address * DateOfBirth * Gender;</layout>
</color>
<color id="8c49d7ef-dc6f-4ea1-9713-5b4dfaba662c">
<!-- cpn-editor:colour=#3b82f6 -->
<id>Emp</id>
<product><id>EmpNo</id><id>Experience</id></product>
<layout>colset Emp = product EmpNo * Experience;</layout>
</color>
<color id="8c887bd1-61dc-43f9-8581-49ceb82ca63e">
<!-- cpn-editor:colour=#8b5cf6 -->
<id>EP</id>
<product><id>Emp</id><id>Pat</id></product>
<layout>colset EP = product Emp * Pat;</layout>
</color>
<var id="1887249b-3711-4ec5-b140-a2381d3dc4af">
<type><id>Pat</id></type>
<id>p</id>
<layout>var p: Pat;</layout>
</var>
<var id="60cde7e2-8a6c-44d9-8b29-8ae0b1f36b4b">
<type><id>Emp</id></type>
<id>emp</id>
<layout>var emp: Emp;</layout>
</var>
<ml id="58c6c65d-3dc3-4f24-86d5-0b6ea1712426">
val Peter = (12345, &quot;Peter&quot;, &quot;Kerkstraat 10, Amsterdam&quot;, &quot;13-Dec-1962&quot;, male);
<layout>val Peter = (12345, &quot;Peter&quot;, &quot;Kerkstraat 10, Amsterdam&quot;, &quot;13-Dec-1962&quot;, male);</layout>
</ml>
<ml id="fe5466c4-2e43-48bf-aa97-88b65ac0aa46">
val Ann = (641112, 7);
<layout>val Ann = (641112, 7);</layout>
</ml>
<ml id="aa46b4bd-342a-4cda-9aec-c98c859718f0">
fun d = if #1(emp)&gt;5 then 3 else 4;
<layout>fun d = if #1(emp)&gt;5 then 3 else 4;</layout>
</ml>
