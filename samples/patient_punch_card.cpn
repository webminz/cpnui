<layout>colset Gender = with male|female;</layout>
</color>
<color id="ID8">
<!-- cpn-editor:colour=#ef4444 -->
<id>Pat</id>
<product><id>PatientID</id><id>Name</id><id>Address</id><id>DateOfBirth</id><id>Gender</id></product>
<layout>colset Pat = product PatientID * Name * Address * DateOfBirth * Gender;</layout>
</color>
