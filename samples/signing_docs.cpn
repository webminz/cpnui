<ml id="95c9815c-d53c-400b-b8ba-57d9b2cf8966">
fun notin(p: Person, s: Signatures) = if s = [] then true else
<layout>fun notin(p: Person, s: Signatures) = if s = [] then true else</layout>
</ml>
<ml id="cd0189a1-b85b-4404-8064-52a4d025a1e6">
if (hd s) = p then false else notin(p, tl s);
<layout>if (hd s) = p then false else notin(p, tl s);</layout>
</ml>
<ml id="76d4d4dc-3467-4060-a918-5a778b98d28e">
fun count(s:Signatures) = if s = [] then 0 else count(tl s);
<layout>fun count(s:Signatures) = if s = [] then 0 else count(tl s);</layout>
</ml>
